---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";

import type { Project } from "@/lib/content";
import { PROJECT_TYPES } from "@/lib/content";

interface Props {
  slug: string;
  project: Project;
  /** Tailwind aspect classes for the photo (grids vary them for rhythm). */
  aspect?: string | undefined;
  /** Headline level inside the surrounding section. */
  headingLevel?: "h2" | "h3";
}

const { aspect = "aspect-[4/3]", headingLevel: Heading = "h3", project, slug } = Astro.props;
const inProgress = project.progress === "in_progress";
---

<article class="group relative flex w-full flex-col outline-offset-4 outline-ring has-[a:focus-visible]:outline-2">
  <div class:list={["relative overflow-hidden bg-muted", aspect]} data-reveal="mask">
    {project.featured_image && (
      <div class="reveal-zoom size-full">
        <Image
          image={project.featured_image}
          alt={project.featured_image.alt ?? project.title}
          sizes="(min-width: 1024px) 58vw, 100vw"
          class="size-full! object-cover transition-transform duration-700 ease-expo group-hover:scale-[1.04] motion-reduce:transition-none"
        />
      </div>
    )}
    <div class="absolute inset-0 bg-ink/0 transition-colors duration-300 group-hover:bg-ink/10" aria-hidden="true"></div>
    {inProgress && (
      <span class="absolute top-4 left-4 bg-timber px-3 py-1.5 text-xs font-semibold text-ink">Under construction</span>
    )}
    <span class="absolute right-5 bottom-5 flex size-12 translate-y-2 items-center justify-center bg-ink text-paper opacity-0 transition-[opacity,translate] duration-200 group-hover:translate-y-0 group-hover:opacity-100" aria-hidden="true">
      <ArrowUpRight class="size-5" />
    </span>
  </div>
  <div class="mt-5 flex items-start justify-between gap-6 border-t-2 border-ink pt-4" data-reveal style="--reveal-delay: 150ms">
    <div>
      <Heading class="text-2xl sm:text-[1.75rem]">
        <a href={`/projects/${slug}`} class="after:absolute after:inset-0 focus-visible:outline-none">{project.title}</a>
      </Heading>
      <p class="mt-2 text-base text-muted-foreground">{PROJECT_TYPES[project.project_type]}{project.location ? ` · ${project.location}` : ""}</p>
    </div>
  </div>
</article>
