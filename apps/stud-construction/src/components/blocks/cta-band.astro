---
import { sanitizeHref } from "emdash";
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import type { PageContentCtaBandBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentCtaBandBlock>;

const { value } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink">
  {value.image && (
    <div class="absolute inset-0 -z-10" data-reveal="fade">
      <Image image={value.image} alt="" sizes="100vw" class="size-full! object-cover" />
    </div>
  )}
  <div class="absolute inset-0 -z-10 bg-ink/70" aria-hidden="true"></div>
  <div class="container-page py-24 sm:py-36">
    <h2 class="max-w-3xl text-5xl text-white sm:text-6xl lg:text-7xl" data-reveal>{value.headline}</h2>
    {value.body && <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80" data-reveal style="--reveal-delay: 100ms">{value.body}</p>}
    {value.cta_label && value.cta_url && (
      <div data-reveal style="--reveal-delay: 200ms">
        <ButtonLink href={sanitizeHref(value.cta_url)} variant="inverse" size="hero" class="mt-10">{value.cta_label}</ButtonLink>
      </div>
    )}
  </div>
</section>
