---
import type { BlockComponentProps } from "emdash/ui";

import Logo from "@/components/brand/logo.astro";
import type { PageContentStatementBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentStatementBlock>;

const { value } = Astro.props;
---

<section class="py-24 sm:py-36">
  <div class="container-page grid gap-12 lg:grid-cols-[auto_minmax(0,1fr)] lg:gap-24">
    <Logo play="scroll" class="h-28 w-auto sm:h-36 lg:h-44" />
    <div>
      <p class="max-w-4xl font-display text-[1.75rem] leading-[1.25] font-medium tracking-[-0.02em] text-ink sm:text-4xl lg:text-[2.75rem]" data-reveal>
        {value.text}
      </p>
      {value.signature && (
        <p class="mt-10 flex items-center gap-4 text-sm font-medium text-muted-foreground" data-reveal style="--reveal-delay: 120ms">
          <span class="h-0.5 w-10 bg-timber" aria-hidden="true"></span>{value.signature}
        </p>
      )}
    </div>
  </div>
</section>
