---
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentProcessBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentProcessBlock>;

const { value } = Astro.props;
---

<section class="bg-ink py-24 text-paper sm:py-32">
  <div class="container-page grid gap-14 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.4fr)] lg:gap-24">
    <div class="lg:sticky lg:top-36 lg:self-start">
      <h2 class="text-4xl text-paper sm:text-5xl" data-reveal>{value.headline}</h2>
      {value.intro && <p class="mt-6 max-w-md text-lg leading-relaxed text-paper/70" data-reveal style="--reveal-delay: 100ms">{value.intro}</p>}
    </div>
    <ol class="border-t border-paper/15">
      {value.items.map((item, index) => (
        <li class="grid gap-3 border-b border-paper/15 py-8 sm:grid-cols-[5rem_1fr] sm:gap-8 sm:py-10" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <span class="font-display text-4xl leading-none font-semibold text-timber tabular-nums sm:text-5xl">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="text-2xl text-paper sm:text-3xl">{item.title}</h3>
            <p class="mt-3 max-w-xl leading-relaxed text-paper/70">{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
