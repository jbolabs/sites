---
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentServicesBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentServicesBlock>;

const { value } = Astro.props;
// Four or fewer read as a row of tall cards; five or six wrap into a three-column grid.
const columns = value.items.length > 4 ? "lg:grid-cols-3" : "lg:grid-cols-4";
---

<section class="bg-concrete py-24 sm:py-32">
  <div class="container-page">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <h2 class="text-4xl sm:text-5xl lg:text-6xl" data-reveal>{value.headline}</h2>
      {value.intro && <p class="max-w-md text-lg leading-relaxed text-muted-foreground lg:justify-self-end" data-reveal style="--reveal-delay: 100ms">{value.intro}</p>}
    </div>
    <ol class:list={["mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:mt-16", columns]}>
      {value.items.map((item, index) => (
        <li class="group" data-reveal style={`--reveal-delay: ${(index % 4) * 90}ms`}>
          {item.image && (
            <div class="relative aspect-[4/3] overflow-hidden bg-muted">
              <Image
                image={item.image}
                alt={item.image.alt ?? ""}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                class="size-full! object-cover transition-transform duration-1600 ease-expo group-hover:scale-105 motion-reduce:transition-none"
              />
            </div>
          )}
          <div class="mt-6 flex items-baseline gap-4 border-t-2 border-ink pt-5">
            <span class="font-display text-sm font-semibold text-timber-deep tabular-nums">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="text-2xl">{item.title}</h3>
          </div>
          <p class="mt-3 leading-relaxed text-muted-foreground">{item.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
