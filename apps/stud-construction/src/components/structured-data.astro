---
/**
 * GeneralContractor (a LocalBusiness) JSON-LD on every page. EmDashHead adds the
 * WebSite graph; this adds the business itself. Unknown facts are omitted
 * rather than guessed (see site.config.ts).
 */
import { BUSINESS_ID } from "@/lib/structured-data";
import { site } from "../../site.config";

interface Props {
  origin: string;
}

const { origin } = Astro.props;
const { business } = site;
interface BusinessJsonLd {
  readonly "@context": string;
  readonly "@id": string;
  readonly "@type": string;
  readonly address: Record<string, string>;
  readonly areaServed: readonly { "@type": string; name: string }[];
  readonly description: string;
  readonly foundingDate: string;
  readonly hasCredential: {
    readonly "@type": "EducationalOccupationalCredential";
    readonly credentialCategory: string;
    readonly name: string;
    readonly recognizedBy: { readonly "@type": string; readonly name: string };
  };
  readonly image: string;
  readonly logo: string;
  readonly name: string;
  readonly sameAs: readonly string[];
  readonly url: string;
  email?: string;
  faxNumber?: string;
  telephone?: string;
}

const data: BusinessJsonLd = {
  "@context": "https://schema.org",
  "@id": `${origin}${BUSINESS_ID}`,
  "@type": "GeneralContractor",
  address: {
    "@type": "PostalAddress",
    addressCountry: "US",
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    streetAddress: business.address.street,
  },
  areaServed: business.areaServed.map((name) => ({
    "@type": "AdministrativeArea",
    name,
  })),
  description: site.description,
  foundingDate: String(site.founded),
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "license",
    name: business.license,
    recognizedBy: { "@type": "GovernmentOrganization", name: "Contractors State License Board" },
  },
  image: `${origin}/og-default.png`,
  logo: `${origin}/brand/logo.png`,
  name: site.name,
  sameAs: site.social.map((profile) => profile.url),
  url: origin,
};
if (business.email !== undefined) {
  data.email = business.email;
}
if (business.fax !== undefined) {
  data.faxNumber = business.fax;
}
if (business.telephone !== undefined) {
  data.telephone = business.telephone;
}
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
