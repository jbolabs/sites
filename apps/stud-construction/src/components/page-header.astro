---
interface Props {
  title: string;
  intro?: string | undefined;
}

const { intro, title } = Astro.props;
---

<section>
  <div class="container-page pt-16 pb-14 sm:pt-24 sm:pb-20">
    <slot name="before" />
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-end lg:gap-20">
      <h1 class="page-rise text-5xl leading-[1] tracking-[-0.035em] sm:text-6xl lg:text-[5.25rem]" style="--d: 0.1s">{title}</h1>
      {intro && <p class="page-rise max-w-xl text-lg leading-relaxed text-muted-foreground sm:text-xl" style="--d: 0.25s">{intro}</p>}
    </div>
    <span class="page-rise mt-12 block h-1.5 w-24 bg-timber" style="--d: 0.35s" aria-hidden="true"></span>
    <slot />
  </div>
</section>

<style>
  .page-rise {
    animation: page-rise 1.1s var(--ease-out-expo) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes page-rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-rise {
      animation: none;
    }
  }
</style>
