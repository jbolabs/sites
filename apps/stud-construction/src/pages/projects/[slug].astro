---
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { decodeSlug, getSeoMeta } from "emdash";
import { PortableText } from "emdash/ui";
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";

import Breadcrumbs from "@/components/breadcrumbs.astro";
import ButtonLink from "@/components/button-link.astro";
import ProjectGallery from "@/components/islands/project-gallery";
import ProjectStructuredData from "@/components/project-structured-data.astro";
import Base from "@/layouts/base.astro";
import { getProject, getProjects, projectFacts, projectSearchTitle } from "@/lib/content";
import { islandImage } from "@/lib/images";
import { instagramLink } from "@/lib/instagram";
import { site } from "../../../site.config";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
  return Astro.rewrite("/404");
}
const [{ cacheHint, entry: project }, all] = await Promise.all([getProject(slug), getProjects()]);
if (!project) {
  return Astro.rewrite("/404");
}
if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
  Astro.cache.set(all.cacheHint);
}
// The next project in portfolio order (wrapping), so every project page leads somewhere.
const position = all.entries.findIndex((entry) => entry.id === project.id);
const next = all.entries.length > 1 ? all.entries[(position + 1) % all.entries.length] : undefined;

const { origin } = Astro.url;
const gallery = (project.data.gallery ?? []).flatMap((item) => (item.image ? [item.image] : []));
const galleryImages = await Promise.all(gallery.map((image) => islandImage(image, origin, [480, 768, 1080, 1440, 1920])));
const facts = projectFacts(project.data);
// Saved links are checked by the project-links plugin; this also skips anything stored before it existed.
const instagram = (project.data.instagram ?? []).flatMap((row) => {
  const link = instagramLink(row.url ?? "");
  return link === undefined ? [] : [link];
});
const seo = getSeoMeta(project, {
  defaultDescription: project.data.summary ?? `${project.data.title}, a remodel by ${site.name} in Orange County.`,
  defaultTitle: projectSearchTitle(project.data),
  path: `/projects/${slug}`,
  siteUrl: origin,
});
const cover = project.data.featured_image;
const pageUrl = seo.canonical ?? `${origin}/projects/${slug}`;
---

<Base
  title={seo.title}
  description={seo.description}
  image={seo.ogImage}
  photo={cover}
  canonical={seo.canonical}
  robots={seo.robots}
  content={{ collection: "projects", id: project.data.id, slug: project.id }}
>
  <ProjectStructuredData
    project={project.data}
    url={pageUrl}
    origin={origin}
    photos={cover ? [cover, ...gallery] : gallery}
    instagram={instagram.map((link) => link.url)}
  />
  <article>
    <header class="container-page pt-14 pb-12 sm:pt-20 sm:pb-16">
      <Breadcrumbs class="mb-10" crumbs={[{ label: "Portfolio", path: "/portfolio" }, { label: project.data.title, path: `/projects/${slug}` }]} />
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-end lg:gap-20">
        <div>
          <h1 class="text-5xl leading-[1] tracking-[-0.035em] sm:text-6xl lg:text-[5.25rem]" data-reveal {...project.edit.title}>{project.data.title}</h1>
          {project.data.summary && <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl" data-reveal style="--reveal-delay: 100ms" {...project.edit.summary}>{project.data.summary}</p>}
        </div>
        {facts.length > 0 && (
          <dl class="grid grid-cols-2 gap-x-8 border-t-2 border-ink sm:grid-cols-3 lg:grid-cols-2">
            {facts.map((fact, index) => (
              <div class="py-4" data-reveal style={`--reveal-delay: ${160 + index * 60}ms`}>
                <dt class="text-base text-muted-foreground">{fact.label}</dt>
                <dd class="mt-1 font-display text-lg font-semibold text-ink">{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </header>

    {cover && (
      <div class="container-page" {...project.edit.featured_image}>
        <div class="relative aspect-[4/3] overflow-hidden bg-muted sm:aspect-[16/9]">
          <Image image={cover} alt={cover.alt ?? project.data.title} priority sizes="(min-width: 1440px) 1360px, 100vw" class="size-full! object-cover" />
        </div>
      </div>
    )}

    {project.data.details && (
      <section class="container-page py-20 sm:py-28">
        <div class="prose-site mx-auto" {...project.edit.details}><PortableText value={project.data.details} /></div>
      </section>
    )}

    {galleryImages.length > 0 && (
      <section class="container-page py-16 sm:py-24" aria-label="Photos">
        <ProjectGallery client:visible title={project.data.title} images={galleryImages} />
      </section>
    )}

    {instagram.length > 0 && (
      <section class="container-page py-16 sm:py-24" aria-labelledby="instagram-heading" {...project.edit.instagram}>
        <h2 id="instagram-heading" class="text-4xl sm:text-5xl" data-reveal>On Instagram</h2>
        <ul class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {instagram.map((link, index) => (
            <li data-reveal style={`--reveal-delay: ${(index % 3) * 80}ms`}>
              {link.kind === "highlight" ? (
                <a href={link.url} target="_blank" rel="noopener" class="group flex aspect-[4/5] flex-col justify-end bg-ink p-8 text-paper">
                  <span class="font-display text-3xl font-semibold tracking-[-0.02em]">More from this project</span>
                  <span class="mt-3 inline-flex items-center gap-1.5 text-paper/75 group-hover:text-paper">Watch the highlight on Instagram<ArrowUpRight class="size-4" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span></span>
                </a>
              ) : (
                <>
                  <div class="overflow-hidden border border-border bg-background">
                    <iframe
                      src={link.embedUrl}
                      title={`${project.data.title} on Instagram`}
                      loading="lazy"
                      referrerpolicy="strict-origin-when-cross-origin"
                      class="block h-[40rem] w-full"
                    ></iframe>
                  </div>
                  <a href={link.url} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1.5 font-medium text-muted-foreground hover:text-ink">
                    {link.kind === "reel" ? "Watch on Instagram" : "View on Instagram"}<ArrowUpRight class="size-4" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span>
                  </a>
                </>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="container-page flex flex-col items-start justify-between gap-8 py-16 sm:flex-row sm:items-center sm:py-20">
      <div data-reveal>
        <p class="font-display text-3xl font-semibold tracking-[-0.02em] text-ink sm:text-4xl">Planning something similar?</p>
      </div>
      <div data-reveal style="--reveal-delay: 100ms"><ButtonLink href="/contact" variant="default" size="hero">Start a project</ButtonLink></div>
    </section>

    <nav class="bg-concrete" aria-label="More projects">
      <div class="container-page flex items-center justify-between gap-6 py-10">
        <a href="/portfolio" class="group inline-flex items-center gap-3 font-medium text-muted-foreground hover:text-ink" data-reveal>
          <ArrowLeft class="size-4 transition-transform duration-200 group-hover:-translate-x-1" aria-hidden="true" />All projects
        </a>
        {next && (
          <a href={`/projects/${next.id}`} class="group text-right" data-reveal style="--reveal-delay: 100ms">
            <span class="block text-sm text-muted-foreground">Next project</span>
            <span class="mt-1 inline-flex items-center gap-3 font-display text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
              {next.data.title}<ArrowRight class="size-5 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
            </span>
          </a>
        )}
      </div>
    </nav>
  </article>
</Base>

