---
/**
 * A product Ani recommends. The shop link may be an affiliate link, so it is
 * marked `sponsored` for search engines and opens in a new tab.
 */
import { sanitizeHref } from "emdash";
import { Image } from "emdash/ui";

import type { ProductEntry } from "@/lib/content";
import { TOPIC_LABELS } from "@/lib/labels";

interface Props {
  product: ProductEntry;
  headingLevel?: "h2" | "h3";
}

const { headingLevel: Heading = "h3", product } = Astro.props;
const { data } = product;
---

<article class="flex h-full flex-col rounded-2xl border border-border bg-card p-6">
  {data.image && (
    <Image image={data.image} sizes="(min-width: 1024px) 25vw, 50vw" class="mb-5 aspect-square w-full rounded-xl bg-sand object-contain" />
  )}
  <p class="text-sm text-muted-foreground">{data.brand}</p>
  <Heading class="mt-1 text-xl leading-snug">{data.title}</Heading>
  <p class="mt-3 flex-1 leading-relaxed text-foreground/80">{data.note}</p>
  <div class="mt-5 flex items-center justify-between gap-3 border-t border-border pt-4">
    <span class="text-sm text-clay">{TOPIC_LABELS[data.concern]}</span>
    <a href={sanitizeHref(data.url)} target="_blank" rel="sponsored noopener" class="font-medium text-espresso-deep underline decoration-clay decoration-1 underline-offset-4 hover:text-clay">
      Shop{data.price_label ? ` ${data.price_label}` : ""}<span class="sr-only"> {data.title} (opens in a new tab)</span>
    </a>
  </div>
</article>
