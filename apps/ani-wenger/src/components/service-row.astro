---
/** One line of the service menu: name and price, what it is, how long, and a way to book. */
import type { ServiceEntry } from "@/lib/content";
import { formatDuration, formatPrice } from "@/lib/labels";

interface Props {
  service: ServiceEntry;
  headingLevel?: "h3" | "h4";
}

const { headingLevel: Heading = "h3", service } = Astro.props;
const { data } = service;
const price = formatPrice(data.price, data.price_from);
const bookable = data.bookable !== false;
---

<article class="group relative border-t border-border py-6">
  <div class="flex items-baseline gap-4">
    <Heading class="text-2xl leading-tight">
      <a href={`/services/${service.id}`} class="after:absolute after:inset-0 hover:text-clay">{data.title}</a>
    </Heading>
    <span class="mb-1.5 hidden flex-1 border-b border-dotted border-espresso/25 sm:block" aria-hidden="true"></span>
    {price && <p class="ml-auto shrink-0 text-lg font-medium text-espresso-deep tabular-nums sm:ml-0">{price}</p>}
  </div>
  <p class="mt-2 max-w-xl leading-relaxed text-muted-foreground">{data.summary}</p>
  <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-ui">
    <span class="text-foreground/70">{formatDuration(data.duration_minutes)}</span>
    {bookable ? (
      <a href={`/book?service=${service.id}`} class="relative z-10 font-medium text-espresso-deep underline decoration-clay decoration-1 underline-offset-4 hover:text-clay">Book this</a>
    ) : (
      <a href="/contact" class="relative z-10 font-medium text-espresso-deep underline decoration-clay decoration-1 underline-offset-4 hover:text-clay">Ask about this</a>
    )}
  </div>
</article>
