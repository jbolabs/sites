---
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentTestimonialsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentTestimonialsBlock>;

const { value } = Astro.props;
---

<section id="reviews" class="py-20 sm:py-28">
  <div class="container-page">
    <h2 class="headline-section max-w-2xl">{value.headline}</h2>
    <div class="mt-12 columns-1 gap-6 md:columns-2 lg:columns-3">
      {value.items.map((item) => (
        <figure class="mb-6 break-inside-avoid rounded-2xl bg-sand/70 p-7 sm:p-8">
          <span class="font-display block text-6xl leading-[0.6] text-clay" aria-hidden="true">&ldquo;</span>
          <blockquote class="mt-3 text-[1.05rem] leading-relaxed text-foreground/85">{item.quote}</blockquote>
          <figcaption class="mt-5 text-ui">
            <span class="font-medium text-espresso-deep">{item.name}</span>
            {item.place && <span class="text-muted-foreground">, {item.place}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
