---
import { sanitizeHref } from "emdash";
import { PortableText } from "emdash/ui";
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import type { PageContentStoryBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentStoryBlock>;

const { value } = Astro.props;
const imageRight = value.image_position === "right";
---

<section class="py-20 sm:py-28">
  <div class="container-page grid items-center gap-12 md:grid-cols-2 md:gap-16 lg:gap-24">
    {value.image && (
      <div class:list={[{ "md:order-2": imageRight }]}>
        <Image image={value.image} sizes="(min-width: 768px) 45vw, 100vw" class="aspect-[4/5] w-full rounded-[2rem] object-cover" />
      </div>
    )}
    <div>
      <h2 class="headline-section">{value.headline}</h2>
      <div class="prose-site mt-7"><PortableText value={value.body} /></div>
      {value.cta_label && value.cta_url && (
        <ButtonLink href={sanitizeHref(value.cta_url)} variant="outline" size="cta" class="mt-9">{value.cta_label}</ButtonLink>
      )}
    </div>
  </div>
</section>
