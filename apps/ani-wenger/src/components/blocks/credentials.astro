---
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentCredentialsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentCredentialsBlock>;

const { value } = Astro.props;
---

<section class="bg-sand/70">
  <div class="container-page py-16 sm:py-20">
    {value.headline && <h2 class="mb-10 max-w-xl text-3xl sm:text-4xl">{value.headline}</h2>}
    <ul class="grid gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-espresso/15">
      {value.items.map((item) => (
        <li class="md:px-8 md:first:pl-0 md:last:pr-0">
          <div class="mb-5 h-px w-12 bg-clay" aria-hidden="true"></div>
          <h3 class="text-2xl leading-snug">{item.title}</h3>
          {item.detail && <p class="mt-3 leading-relaxed text-foreground/75">{item.detail}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>
