---
/** Maps each EmDash block type to its renderer. Add new section types here and in seed/seed.json. */
import { Blocks, defineBlockComponents } from "emdash/ui";

import type { PageContentBlock } from "../../../emdash-env";
import Credentials from "./credentials.astro";
import CtaBand from "./cta-band.astro";
import Faq from "./faq.astro";
import Hero from "./hero.astro";
import ProductsList from "./products-list.astro";
import QuestionsList from "./questions-list.astro";
import RichText from "./rich-text.astro";
import ServicesMenu from "./services-menu.astro";
import Story from "./story.astro";
import Testimonials from "./testimonials.astro";
import Transformations from "./transformations.astro";
import Visit from "./visit.astro";

interface Props {
  value?: PageContentBlock[] | null | undefined;
}

const { value } = Astro.props;
const components = defineBlockComponents<PageContentBlock>({
  credentials: Credentials,
  cta_band: CtaBand,
  faq: Faq,
  hero: Hero,
  products_list: ProductsList,
  questions_list: QuestionsList,
  rich_text: RichText,
  services_menu: ServicesMenu,
  story: Story,
  testimonials: Testimonials,
  transformations: Transformations,
  visit: Visit,
});
---

<Blocks value={value} components={components} />
