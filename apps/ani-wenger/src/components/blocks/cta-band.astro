---
import { sanitizeHref } from "emdash";
import { Image } from "emdash/ui";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import type { PageContentCtaBandBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentCtaBandBlock>;

const { value } = Astro.props;
---

<section class="container-page py-10 sm:py-16">
  <div class="relative isolate overflow-hidden rounded-[2rem] bg-espresso-deep">
    {value.image && (
      <Image image={value.image} alt="" sizes="(min-width: 1280px) 1200px, 100vw" class="absolute inset-0 -z-10 size-full! object-cover" />
    )}
    <div class="absolute inset-0 -z-10 bg-linear-to-r from-espresso-deep/95 via-espresso-deep/80 to-espresso-deep/40" aria-hidden="true"></div>
    <div class="flex flex-col items-start gap-8 px-8 py-16 sm:px-14 sm:py-20 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-[clamp(2.25rem,5vw,3.75rem)] leading-[1.04] text-ivory">{value.headline}</h2>
        {value.body && <p class="mt-4 text-lg text-ivory/80">{value.body}</p>}
      </div>
      {value.cta_label && value.cta_url && (
        <ButtonLink href={sanitizeHref(value.cta_url)} variant="inverse" size="hero" class="shrink-0">{value.cta_label}</ButtonLink>
      )}
    </div>
  </div>
</section>
