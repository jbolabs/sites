---
/** The salon, its hours, and how to reach Ani, from the "Salon and hours" entry. */
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import { getStudio } from "@/lib/content";
import { addressLine, hoursLines, telHref } from "@/lib/studio";
import type { PageContentVisitBlock } from "../../../emdash-env";
import { site } from "../../../site.config";

type Props = BlockComponentProps<PageContentVisitBlock>;

const { value } = Astro.props;
const { cacheHint, entry } = await getStudio();
if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
}
const studio = entry?.data;
---

{studio && (
  <section class="py-20 sm:py-24">
    <div class="container-page grid gap-10 rounded-[2rem] bg-sand/70 p-8 sm:p-12 lg:grid-cols-[1.2fr_1fr_1fr] lg:gap-14">
      <div>
        <h2 class="text-3xl sm:text-4xl">{value.headline}</h2>
        {value.intro && <p class="mt-4 leading-relaxed text-foreground/75">{value.intro}</p>}
        <ButtonLink href="/book" size="cta" class="mt-8">Book an appointment</ButtonLink>
      </div>
      <div class="space-y-3 leading-relaxed">
        <h3 class="text-xl">Where</h3>
        <p>{addressLine(studio)}</p>
        {studio.arrival_note && <p class="text-foreground/75">{studio.arrival_note}</p>}
        {studio.map_url && <p><a href={sanitizeHref(studio.map_url)} class="font-medium text-espresso-deep underline decoration-clay underline-offset-4">Open in Maps</a></p>}
        <h3 class="pt-4 text-xl">Call or email</h3>
        <p><a href={telHref(studio.phone)} class="hover:text-clay">{studio.phone}</a> <span class="text-foreground/60">(Ani)</span></p>
        {studio.salon_phone && <p><a href={telHref(studio.salon_phone)} class="hover:text-clay">{studio.salon_phone}</a> <span class="text-foreground/60">(salon front desk)</span></p>}
        <p><a href={`mailto:${site.business.email}`} class="break-all hover:text-clay">{site.business.email}</a></p>
      </div>
      <div>
        <h3 class="text-xl">Hours</h3>
        <dl class="mt-3 space-y-3">
          {hoursLines(studio).map((line) => (
            <div>
              <dt class="font-medium text-espresso-deep">{line.days}</dt>
              <dd class="text-foreground/75">{line.times}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
)}
