---
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";

import type { QuestionEntry } from "@/lib/content";
import { TOPIC_LABELS } from "@/lib/labels";

interface Props {
  question: QuestionEntry;
}

const { question } = Astro.props;
const { data } = question;
---

<article class="press group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-card">
  {data.image ? (
    <Image image={data.image} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
  ) : (
    <div class="aspect-[4/3] w-full bg-sand" aria-hidden="true"></div>
  )}
  <div class="flex flex-1 flex-col p-6">
    <p class="text-sm font-medium text-clay">{TOPIC_LABELS[data.topic]}</p>
    <h3 class="mt-2 text-2xl leading-snug">
      <a href={`/ask-ani/${question.id}`} class="after:absolute after:inset-0 group-hover:text-clay">{data.title}</a>
    </h3>
    <p class="mt-3 line-clamp-3 leading-relaxed text-muted-foreground">{data.summary}</p>
    <p class="mt-auto pt-5 text-ui font-medium text-espresso-deep underline decoration-clay decoration-1 underline-offset-4">Read the answer</p>
  </div>
</article>
