---
interface Props {
  title: string;
  intro?: string | null | undefined;
}

const { intro, title } = Astro.props;
---

<section class="border-b border-border bg-linen">
  <div class="container-page py-9 sm:py-20 lg:py-24">
    <slot name="before" />
    <h1 class="max-w-4xl text-[clamp(2.25rem,6vw,4.5rem)] leading-[1.02]">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:mt-6 sm:text-xl">{intro}</p>}
    <slot />
  </div>
</section>
