---
import { decodeSlug, getSeoMeta } from "emdash";
import { PortableText } from "emdash/ui";
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";

import Breadcrumbs from "@/components/breadcrumbs.astro";
import ButtonLink from "@/components/button-link.astro";
import ProductCard from "@/components/product-card.astro";
import ServiceRow from "@/components/service-row.astro";
import Base from "@/layouts/base.astro";
import { getQuestion } from "@/lib/content";
import { TOPIC_LABELS } from "@/lib/labels";
import { site } from "../../../site.config";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
  return Astro.rewrite("/404");
}
const { cacheHint, entry: question } = await getQuestion(slug);
if (!question) {
  return Astro.rewrite("/404");
}
if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
}
const { data } = question;
const path = `/ask-ani/${slug}`;
const seo = getSeoMeta(question, { defaultDescription: data.summary, path, siteUrl: Astro.url.origin });
const products = question.references?.products.entries ?? [];
const services = question.references?.services.entries ?? [];
const origin = Astro.site?.origin ?? Astro.url.origin;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  author: { "@type": "Person", jobTitle: "Master hairstylist", name: site.name, url: `${origin}/about` },
  dateModified: data.updatedAt.toISOString(),
  datePublished: (data.publishedAt ?? data.createdAt).toISOString(),
  description: data.summary,
  headline: data.title,
  mainEntityOfPage: `${origin}${path}`,
  publisher: { "@id": `${origin}/#business` },
});
---

<Base
  title={seo.title}
  description={seo.description}
  image={seo.ogImage}
  photo={data.image}
  canonical={seo.canonical}
  robots={seo.robots}
  pageType="article"
  content={{ collection: "questions", id: data.id, slug: question.id }}
>
  <article>
    <header class="border-b border-border bg-linen">
      <div class="container-page py-12 sm:py-16">
        <Breadcrumbs crumbs={[{ label: "Home", path: "/" }, { label: "Ask Ani", path: "/ask-ani" }, { label: data.title, path }]} />
        <p class="mt-8 text-ui font-medium text-clay">{TOPIC_LABELS[data.topic]}</p>
        <h1 class="mt-3 max-w-4xl text-[clamp(2.25rem,5.4vw,4rem)] leading-[1.05]">{data.title}</h1>
        <div class="mt-8 max-w-3xl rounded-2xl border border-espresso/10 bg-card p-6 sm:p-8">
          <p class="font-display text-xl text-espresso-deep">The short answer</p>
          <p class="mt-3 text-lg leading-relaxed text-foreground/85">{data.summary}</p>
        </div>
      </div>
    </header>
    <div class="container-page grid gap-12 py-14 sm:py-20 lg:grid-cols-[1.6fr_1fr] lg:gap-20">
      <div>
        {data.image && <Image image={data.image} sizes="(min-width: 1024px) 55vw, 100vw" class="mb-10 aspect-[16/10] w-full rounded-2xl object-cover" />}
        <div class="prose-site" {...question.edit.body}><PortableText value={data.body} /></div>
        <p class="mt-12 border-t border-border pt-6 text-ui text-muted-foreground">Written by Ani Wenger, European master hairstylist. This is general hair care advice, not medical advice.</p>
      </div>
      <aside class="space-y-10 lg:sticky lg:top-28 lg:self-start">
        {services.length > 0 && (
          <section>
            <h2 class="text-2xl">Book the help</h2>
            <div class="mt-2 border-b border-border">
              {services.map((service) => <ServiceRow service={service} />)}
            </div>
          </section>
        )}
        <div class="rounded-2xl bg-espresso-deep p-7 text-ivory">
          <p class="font-display text-2xl">Want advice for your hair?</p>
          <p class="mt-2 text-ivory/75">Bring your questions to a consultation. We will look at your hair together.</p>
          <ButtonLink href="/book" variant="inverse" size="cta" class="mt-6">Book with Ani</ButtonLink>
        </div>
      </aside>
    </div>
    {products.length > 0 && (
      <section class="bg-sand/60 py-16 sm:py-20">
        <div class="container-page">
          <h2 class="headline-section">What I recommend</h2>
          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {products.map((product) => <ProductCard product={product} />)}
          </div>
          <p class="mt-6 text-sm text-muted-foreground">Some links earn a small commission at no cost to you. I only recommend what I use.</p>
        </div>
      </section>
    )}
  </article>
  <script type="application/ld+json" set:html={jsonLd} />
</Base>
