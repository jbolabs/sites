---
/** The booking flow; the `book` page entry holds the title, intro, and sections below. */
import { env } from "cloudflare:workers";
import { getSeoMeta } from "emdash";

import PageBlocks from "@/components/blocks/page-blocks.astro";
import BookingFlow from "@/components/islands/booking-flow";
import PageHeader from "@/components/page-header.astro";
import Base from "@/layouts/base.astro";
import { getPage, getServices, getStudio } from "@/lib/content";
import { toLocal } from "@/lib/booking/calendar";
import { CATEGORY_LABELS, CATEGORY_ORDER, formatDuration, formatPrice } from "@/lib/labels";
import { site } from "../../site.config";

const [{ cacheHint, entry: page }, list, studio] = await Promise.all([getPage("book"), getServices(), getStudio()]);
if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
  Astro.cache.set(list.cacheHint);
  Astro.cache.set(studio.cacheHint);
}
const services = CATEGORY_ORDER.flatMap((category) =>
  list.services.flatMap((service) =>
    service.data.category === category && service.data.bookable !== false
      ? [
          {
            category,
            categoryLabel: CATEGORY_LABELS[category],
            duration: formatDuration(service.data.duration_minutes),
            price: formatPrice(service.data.price, service.data.price_from),
            slug: service.id,
            summary: service.data.summary,
            title: service.data.title,
          },
        ]
      : []
  )
);
const title = page?.data.title ?? "Book an appointment";
const seo = page ? getSeoMeta(page, { defaultDescription: page.data.intro, path: "/book", siteUrl: Astro.url.origin }) : undefined;
const phone = studio.entry?.data.phone ?? site.phone;
---

<Base
  title={seo?.title ?? title}
  description={seo?.description}
  image={seo?.ogImage}
  robots={seo?.robots}
  content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
  <PageHeader title={title} intro={page?.data.intro} />
  <section class="container-page py-14 sm:py-20">
    <BookingFlow
      client:load
      services={services}
      initialService={Astro.url.searchParams.get("service") ?? undefined}
      turnstileSiteKey={env.TURNSTILE_SITE_KEY}
      timeZone={site.timeZone}
      today={toLocal(new Date(), site.timeZone).date}
      bookingNote={studio.entry?.data.booking_note ?? ""}
      phone={phone}
    />
    <noscript>
      <p class="mt-6 text-lg">Online booking needs JavaScript. Please call <a href={`tel:${phone}`} class="underline">{phone}</a> to book.</p>
    </noscript>
  </section>
  {page && <div {...page.edit.content}><PageBlocks value={page.data.content} /></div>}
</Base>
