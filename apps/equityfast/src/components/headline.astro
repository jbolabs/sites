---
/** CMS headline parts share one typographic voice; emphasis comes from the words. */
interface Props {
  as?: "h1" | "h2" | "h3";
  text: string;
  accent?: string | null | undefined;
  inline?: boolean;
  tone?: "light" | "dark";
  class?: string;
}
const { accent, as: Tag = "h2", class: className, text, tone = "light" } = Astro.props;
---
<Tag class:list={["headline-section", tone === "dark" && "text-white", className]}>{text}{accent && ` ${accent}`}</Tag>
