---
/** A direct close, with one action and the optional supporting destination. */
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import ButtonLink from "@/components/button-link.astro";
import InstagramIcon from "@/components/instagram-icon.astro";
import { site } from "../../../site.config";
import { ui } from "@/i18n/ui";
import { toLocale } from "@/i18n/locales";
import { applyHref } from "@/lib/apply";
import type { PageContentCtaBandBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentCtaBandBlock>;
const { value } = Astro.props;
const t = ui(toLocale(Astro.currentLocale));
const layout = value.layout ?? "centered";
---
<section class:list={["closing-field", `closing-${layout}`]}>
  <div class="container-page closing-layout" data-reveal-group>
    <h2 class="headline-section text-white">{value.headline}</h2>
    <div>
      {value.body && <p class="max-w-lg text-base leading-relaxed">{value.body}</p>}
      <div class="mt-8 flex flex-wrap items-center gap-6">
        {value.apply_label && <ButtonLink href={applyHref(Astro.currentLocale)} data-apply variant="inverse" size="hero">{value.apply_label}</ButtonLink>}
        {value.secondary_cta_label && value.secondary_cta_url && <a class="text-link" href={sanitizeHref(value.secondary_cta_url)}>{value.secondary_cta_label}</a>}
      </div>
      {value.show_social && <a href={site.business.instagram} rel="noopener me" target="_blank" class="text-link mt-6 gap-2"><InstagramIcon class="size-4" />{t.followUs}</a>}
    </div>
  </div>
</section>
