---
/** Cards with a rounded photo, a small label pill on it, a title, and paragraphs. */
import { Image } from "emdash/ui";
import type { BlockComponentProps } from "emdash/ui";

import Headline from "@/components/headline.astro";
import { paragraphs } from "@/lib/content";
import type { PageContentImageCardsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentImageCardsBlock>;

const { value } = Astro.props;
---

<section class="section-y bg-canvas">
  <div class="container-page">
    <div data-reveal><Headline text={value.headline} accent={value.headline_accent} inline /></div>
    <ul class="mt-12 grid gap-4 md:grid-cols-3" data-reveal-group>
      {value.items.map((item) => (
        <li class="flex flex-col overflow-hidden rounded-3xl border border-line bg-white">
          <div class="relative m-2 aspect-[4/3] overflow-hidden rounded-[1.25rem] bg-canvas">
            {item.image && <Image image={item.image} sizes="(min-width: 768px) 33vw, 100vw" class="size-full! object-cover" />}
            {item.kicker && <p class="absolute bottom-3 left-3 rounded-full bg-white px-3 py-1 text-xs font-medium text-ink">{item.kicker}</p>}
          </div>
          <div class="flex-1 p-6 pt-5 sm:p-7 sm:pt-5">
            <h3 class="text-2xl tracking-[-0.03em]">{item.title}</h3>
            <div class="mt-4 space-y-3 leading-relaxed text-graphite">
              {paragraphs(item.body).map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
