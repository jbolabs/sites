---
/** Photographs and complete captions, composed as an opening spread and two details. */
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";
import type { BlockComponentProps } from "emdash/ui";
import Headline from "@/components/headline.astro";
import { paragraphs } from "@/lib/content";
import type { PageContentImageCardsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentImageCardsBlock>;
const { value } = Astro.props;
---
<section class="section-y">
  <div class="container-page">
    <Headline text={value.headline} accent={value.headline_accent} inline class="max-w-4xl" />
    <div class="photo-stories mt-12">
      {value.items.map((item) => <article data-reveal-group>
        {item.image && <div class="story-photo"><Image image={item.image} sizes="(min-width: 1024px) 50vw, 100vw" class="size-full! object-cover" /></div>}
        <div class="story-copy">
          <h3>{item.title}</h3>
          {item.kicker && <p class="mt-3">{item.kicker}</p>}
          <div class="mt-5 space-y-3 leading-relaxed">{paragraphs(item.body).map((paragraph) => <p>{paragraph}</p>)}</div>
        </div>
      </article>)}
    </div>
  </div>
</section>
