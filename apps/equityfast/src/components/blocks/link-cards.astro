---
/** A short reading list: the destination itself is the action. */
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentLinkCardsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentLinkCardsBlock>;
const { value } = Astro.props;
---
<section class="section-y bg-canvas">
  <div class="container-page">
    <h2 class="headline-section" data-reveal>{value.headline}</h2>
    <ul class="reading-list mt-12" data-reveal-group>
      {value.items.map((item) => <li><h3>{item.url ? <a href={sanitizeHref(item.url)}>{item.title}</a> : item.title}</h3><p>{item.body}</p>{item.url && <span aria-hidden="true">{item.link_label}</span>}</li>)}
    </ul>
  </div>
</section>
