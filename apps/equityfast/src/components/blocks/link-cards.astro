---
/** A grid of cards linking to other pages; the whole card is the link. */
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentLinkCardsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentLinkCardsBlock>;

const { value } = Astro.props;
---

<section class="section-y bg-canvas">
  <div class="container-page">
    <h2 class="headline-section">{value.headline}</h2>
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {value.items.map((item) => (
        <li class="group relative flex min-h-64 flex-col rounded-3xl border border-line bg-white p-7 transition-[border-color,box-shadow] duration-300 hover:border-ink/15 hover:shadow-lift focus-within:border-ink/15">
          <h3 class="text-xl">
            {item.url ? <a href={sanitizeHref(item.url)} class="after:absolute after:inset-0 after:rounded-3xl focus-visible:outline-none">{item.title}</a> : item.title}
          </h3>
          <p class="mt-3 flex-1 leading-relaxed text-graphite">{item.body}</p>
          {item.url && (
            <div class="mt-8 flex items-center gap-4 text-sm font-medium" aria-hidden="true">
              {item.link_label && <span>{item.link_label}</span>}
              <span class="ml-auto flex size-10 items-center justify-center rounded-full border border-line transition-colors duration-300 group-hover:border-ink group-hover:bg-ink group-hover:text-white">
                <ArrowUpRight class="size-4 transition-transform duration-300 group-hover:rotate-45" />
              </span>
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
