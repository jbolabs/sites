---
/** The program's actual specifications, in a readable definition table. */
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import Headline from "@/components/headline.astro";
import type { PageContentGuidelinesBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentGuidelinesBlock>;
const { value } = Astro.props;
---
<section class="section-y bg-canvas">
  <div class="container-page guidelines-layout">
    <div data-reveal-group>
      <Headline text={value.headline} accent={value.headline_accent} />
      {value.body && <p class="mt-8 max-w-md text-base leading-relaxed">{value.body}</p>}
      {value.link_label && value.link_url && <a href={sanitizeHref(value.link_url)} class="text-link mt-8">{value.link_label}</a>}
    </div>
    <div data-reveal>
      <dl class="specifications">
        {value.items.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
      </dl>
      {value.footnote && <p class="mt-6 text-base leading-relaxed">{value.footnote}</p>}
    </div>
  </div>
</section>
