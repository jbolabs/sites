---
/** The home's value is the subject: one headline, a photograph, and a usable estimate. */
import { sanitizeHref } from "emdash";
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";
import type { BlockComponentProps } from "emdash/ui";
import ButtonLink from "@/components/button-link.astro";
import EquityEstimator from "@/components/islands/equity-estimator";
import { toLocale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import { applyHref } from "@/lib/apply";
import type { PageContentHomeHeroBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentHomeHeroBlock>;
const { value } = Astro.props;
const t = ui(toLocale(Astro.currentLocale));
const apply = applyHref(Astro.currentLocale);
const showEstimator = value.show_estimator !== false;
---
<section class="equity-hero">
  <div class="container-page hero-grid">
    <div class="hero-intro">
      <h1 class="hero-title animate-rise">{value.headline}</h1>
      <div class="hero-support stagger-1 animate-rise">
        {value.intro && <p>{value.intro}</p>}
        {value.tagline && <p class="mt-3">{value.tagline}</p>}
        {value.secondary_cta_label && value.secondary_cta_url && <a class="text-link mt-5" href={sanitizeHref(value.secondary_cta_url)}>{value.secondary_cta_label}</a>}
        {!showEstimator && value.apply_label && <ButtonLink href={apply} data-apply variant="accent" size="hero" class="mt-6">{value.apply_label}</ButtonLink>}
      </div>
    </div>
    <div class="hero-stage">
      {value.image && <div class="hero-photograph stagger-2 animate-lift"><Image image={value.image} priority sizes="(min-width: 1024px) 55vw, 100vw" class="hero-photo" /></div>}
      {showEstimator && <div class="hero-estimate stagger-1 animate-lift"><EquityEstimator client:load strings={t.estimator} applyHref={apply} /></div>}
    </div>
  </div>
</section>
