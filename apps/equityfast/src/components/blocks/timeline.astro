---
/** A vertical timeline: sky dots on a thin rule, each stage's label and what happens. */
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentTimelineBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentTimelineBlock>;

const { value } = Astro.props;
---

<section class="section-y">
  <div class="container-page grid *:min-w-0 gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
    <h2 class="headline-section lg:sticky lg:top-28 lg:self-start" data-reveal>{value.headline}</h2>
    <ol class="space-y-10 border-l border-line pl-8" data-reveal-group>
      {value.items.map((item) => (
        <li class="relative">
          <span class="absolute top-1 -left-[38px] size-3 rounded-full bg-sky ring-4 ring-white" aria-hidden="true"></span>
          <h3 class="tabular-nums text-sm font-normal tracking-normal text-sky-ink">{item.label}</h3>
          <p class="mt-2 text-xl leading-snug tracking-tight text-ink">{item.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
