---
/**
 * Questions that open in place (native `<details>`: no JavaScript, and the
 * answers stay in the HTML for search), plus their FAQPage JSON-LD.
 */
import Plus from "@lucide/astro/icons/plus";
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentFaqBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentFaqBlock>;

const { value } = Astro.props;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: value.items.map((item) => ({
    "@type": "Question",
    acceptedAnswer: { "@type": "Answer", text: item.answer },
    name: item.question,
  })),
});
---

<section class="section-y">
  <div class="container-page grid *:min-w-0 gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
    <h2 class="headline-section lg:sticky lg:top-28 lg:self-start">{value.headline}</h2>
    <div class="border-t border-line">
      {value.items.map((item, index) => (
        <details class="group border-b border-line" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left text-lg font-medium tracking-tight text-ink marker:hidden sm:text-xl [&::-webkit-details-marker]:hidden">
            {item.question}
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-canvas transition-colors group-open:bg-ink group-open:text-white">
              <Plus class="size-4 transition-transform duration-300 group-open:rotate-45" aria-hidden="true" />
            </span>
          </summary>
          <p class="max-w-2xl pb-7 text-lg leading-relaxed text-graphite">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={jsonLd} />
</section>
