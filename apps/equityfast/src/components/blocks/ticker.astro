---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentTickerBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentTickerBlock>;
const { value } = Astro.props;
---
<div class="bg-canvas py-8"><ul class="container-page flex flex-wrap gap-x-10 gap-y-4 text-base">{value.items.map((item) => <li>{item.text}</li>)}</ul></div>
