---
/** A feature-by-feature comparison table; on phones each row stacks into a labeled card. */
import type { BlockComponentProps } from "emdash/ui";

import Headline from "@/components/headline.astro";
import type { PageContentComparisonBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentComparisonBlock>;

const { value } = Astro.props;
---

<section class="section-y">
  <div class="container-page">
    <div data-reveal><Headline text={value.headline} accent={value.headline_accent} /></div>
    <div class="mt-12 overflow-hidden rounded-3xl border border-line" data-reveal>
      <table class="w-full text-left">
        <caption class="sr-only">{value.headline}</caption>
        <thead class="hidden border-b border-line bg-canvas text-sm sm:table-header-group">
          <tr>
            <th scope="col" class="px-8 py-5 font-normal text-graphite">{value.feature_label}</th>
            <th scope="col" class="bg-sky-wash/60 px-8 py-5 font-medium text-ink">
              <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-sky" aria-hidden="true"></span>{value.ours_label}</span>
            </th>
            <th scope="col" class="px-8 py-5 font-normal text-graphite">{value.theirs_label}</th>
          </tr>
        </thead>
        <tbody>
          {value.rows.map((row) => (
            <tr class="grid border-t border-line first:border-t-0 sm:table-row">
              <th scope="row" class="px-6 pt-6 text-sm font-normal text-graphite sm:px-8 sm:py-6 sm:text-base">{row.feature}</th>
              <td class="px-6 pt-2 text-lg font-medium tracking-tight text-ink sm:bg-sky-wash/60 sm:px-8 sm:py-6">
                <span class="block text-xs font-normal tracking-normal text-sky-ink sm:hidden">{value.ours_label}</span>{row.ours}
              </td>
              <td class="px-6 pt-2 pb-6 text-graphite sm:px-8 sm:py-6">
                <span class="block text-xs sm:hidden">{value.theirs_label}</span>{row.theirs}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
