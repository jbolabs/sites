---
/** Side-by-side program cards on canvas, each with a badge and a checked feature list. */
import Check from "@lucide/astro/icons/check";
import type { BlockComponentProps } from "emdash/ui";

import Headline from "@/components/headline.astro";
import { cn } from "@/lib/utils";
import type { PageContentProgramsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentProgramsBlock>;

const { value } = Astro.props;
const lines = (text: string) => text.split("\n").map((line) => line.trim()).filter((line) => line !== "");
// Alternate badges: ink, then sky.
const badge = (index: number) => (index % 2 === 0 ? "bg-ink text-white" : "bg-sky-wash text-sky-ink");
---

<section class="section-y bg-canvas">
  <div class="container-page">
    <div data-reveal>
      <Headline text={value.headline} accent={value.headline_accent} />
    {value.body && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-graphite">{value.body}</p>}
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2" data-reveal-group>
      {value.items.map((program, index) => (
        <article class="rounded-3xl border border-line bg-white p-8 sm:p-10">
          {program.badge && <p class={cn("inline-flex rounded-full px-3 py-1 text-xs font-medium", badge(index))}>{program.badge}</p>}
          <h3 class="mt-6 text-2xl tracking-[-0.03em] sm:text-3xl">{program.title}</h3>
          {program.body && <p class="mt-3 leading-relaxed text-graphite">{program.body}</p>}
          <ul class="mt-8 border-t border-line">
            {lines(program.features).map((feature) => (
              <li class="flex items-start gap-3 border-b border-line py-3.5 text-ink/85 last:border-b-0">
                <Check class="mt-0.5 size-4 shrink-0 text-sky-ink" stroke-width={2.5} aria-hidden="true" />{feature}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
