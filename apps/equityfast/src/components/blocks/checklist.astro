---
/** Benefits read as an editorial list, without repeating a card around every claim. */
import type { BlockComponentProps } from "emdash/ui";
import ButtonLink from "@/components/button-link.astro";
import Headline from "@/components/headline.astro";
import { applyHref } from "@/lib/apply";
import type { PageContentChecklistBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentChecklistBlock>;
const { value } = Astro.props;
---
<section class="section-y">
  <div class="container-page benefits-layout">
    <div data-reveal-group>
      <Headline text={value.headline} accent={value.headline_accent} />
      {value.body && <p class="mt-8 max-w-md text-base leading-relaxed">{value.body}</p>}
      {value.apply_label && <ButtonLink href={applyHref(Astro.currentLocale)} data-apply variant="accent" size="hero" class="mt-8">{value.apply_label}</ButtonLink>}
    </div>
    <ul class="benefits-list" data-reveal-group>
      {value.items.map((item) => <li><h3>{item.title}</h3><p>{item.body}</p></li>)}
    </ul>
  </div>
</section>
