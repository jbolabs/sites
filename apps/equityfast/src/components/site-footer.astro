---
/**
 * Lender identity (legal name, address, NMLS, Equal Housing), the locale's
 * footer menu, and the CMS-edited disclosures. The NMLS number and address
 * come from site.config.ts so structured data and the footer never disagree.
 */
import type { Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import type { NavItem } from "@/lib/content";
import { site } from "../../site.config";
import EqualHousingIcon from "./equal-housing-icon.astro";
import InstagramIcon from "./instagram-icon.astro";

interface Props {
  locale: Locale;
  items: readonly NavItem[];
  disclosure: readonly string[];
  /**
   * Ad landing pages: the page's own footnotes, numbered, in place of the
   * site disclosures, under the lender line compliance requires.
   */
  notes?: readonly string[] | undefined;
}

const { disclosure, items, locale, notes } = Astro.props;
const t = ui(locale);
const { address, email, instagram, legalName, nmls, tradeName } = site.business;
const nmlsHref = `https://www.nmlsconsumeraccess.org/EntityDetails.aspx/COMPANY/${nmls}`;
/** Links compliance asked for that EquityFast still has to supply pages for. */
const PENDING_LINKS = ["State licensing", "Terms", "Do not sell or share my personal information"];
const year = new Date().getFullYear();
const fullAddress = `${address.street}, ${address.city}, ${address.region} ${address.postalCode}`;
const mapsHref = `https://maps.google.com/?q=${encodeURIComponent(fullAddress)}`;
---

{notes ? (
<footer class="border-t border-line bg-canvas text-graphite">
  <div class="mx-auto w-full max-w-[1440px] space-y-8 px-5 pt-12 pb-10 sm:px-8 lg:px-10">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div class="space-y-3">
        <img src="/brand/equityfast-ink.webp" alt="EquityFast" width="1200" height="171" loading="lazy" class="h-6 w-auto" />
        <p class="text-sm">{tradeName}. <a href={nmlsHref} rel="noopener" target="_blank" class="text-ink underline underline-offset-4">NMLS #{nmls}</a>. Equal Housing Lender.</p>
        <p class="text-sm">{address.street}, {address.city}, {address.region} {address.postalCode} · <a href={`mailto:${email}`} class="text-ink underline underline-offset-4">{email}</a></p>
      </div>
      <EqualHousingIcon class="size-10 shrink-0 text-ink/70" label="Equal Housing Lender" />
    </div>
    <ol class="space-y-3 text-sm leading-relaxed">
      {notes.map((note, index) => (
        <li class="flex gap-2"><sup class="pt-2 font-medium text-ink">{index + 1}</sup><span>{note}</span></li>
      ))}
      <li>Not all applicants or properties will qualify, and certain programs may not be available in all states. This is not a commitment to lend. Loan amounts, rates, fees, and terms vary by applicant and state.</li>
    </ol>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {PENDING_LINKS.map((label) => <li>{label} <span class="text-graphite">[page needed from EquityFast]</span></li>)}
    </ul>
    <p class="pb-safe text-sm">&copy; {year} {tradeName}. {t.rights}</p>
  </div>
</footer>
) : (
<footer class="border-t border-line bg-canvas text-graphite">
  <div class="mx-auto grid w-full max-w-[1440px] gap-12 px-5 pt-16 pb-12 sm:px-8 md:grid-cols-[1.4fr_1fr_auto] lg:px-10">
    <div class="space-y-6">
      <img src="/brand/equityfast-ink.webp" alt="EquityFast" width="1200" height="171" loading="lazy" class="h-6 w-auto" />
      <div class="flex items-center gap-3 text-sm">
        <span>{t.poweredBy}</span>
        <img src="/brand/emc.webp" alt={legalName} width="640" height="145" loading="lazy" class="h-6 w-auto" />
      </div>
      <p class="font-mono text-xs">NMLS #{nmls} · {t.equalHousing}</p>
    </div>
    <address class="space-y-2 text-sm not-italic">
      <a href={mapsHref} rel="noopener" target="_blank" class="block text-ink/80 hover:text-ink">{address.street}<br />{address.city}, {address.region} {address.postalCode}</a>
      <a href={`mailto:${email}`} class="block text-ink/80 hover:text-ink">{email}</a>
      <a href={instagram} rel="noopener me" target="_blank" class="inline-flex items-center gap-2 pt-2 text-ink/80 hover:text-ink">
        <InstagramIcon class="size-4" />@equityfast
      </a>
    </address>
    <nav aria-label={t.footerNav}>
      <ul class="grid gap-2 text-sm font-medium sm:grid-cols-2 md:grid-cols-1">
        {items.map((item) => (
          <li><a href={item.url} class="inline-flex min-h-7 items-center text-ink/80 hover:text-ink">{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-10">
    <div class="flex flex-col gap-6 border-t border-line pt-8 sm:flex-row sm:items-start">
      <EqualHousingIcon class="size-10 shrink-0 text-ink/70" label={t.equalHousing} />
      <div class="space-y-3 text-xs leading-relaxed">
        {disclosure.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <p class="pb-safe pt-6 text-xs">&copy; {year} {legalName} {t.rights}</p>
  </div>
</footer>
)}
