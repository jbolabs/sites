---
/**
 * Solid white header on every page: wordmark, "Powered by" lender logo, the
 * locale's CMS menu, Instagram, language switch, and the application CTA (a
 * real link to the apply page; the dialog island intercepts it when
 * JavaScript runs).
 */
import { APPLY_PATH, localePath } from "@/i18n/locales";
import type { Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import type { Alternates, NavItem } from "@/lib/content";
import { site } from "../../site.config";
import ButtonLink from "./button-link.astro";
import InstagramIcon from "./instagram-icon.astro";
import MobileMenu from "@jakebodea/site-ui/mobile-menu";

interface Props {
  locale: Locale;
  items: readonly NavItem[];
  alternates: Alternates;
}

const { alternates, items, locale } = Astro.props;
const t = ui(locale);
const current = Astro.url.pathname.replace(/\/$/u, "") || "/";
const home = localePath(locale, "/");
const isActive = (url: string) => (url === home ? current === home : current === url || current.startsWith(`${url}/`));
const other: Locale = locale === "en" ? "es" : "en";
const switchHref = alternates[other] ?? localePath(other, "/");
---

<header class="sticky top-0 z-40 border-b border-line bg-white text-ink">
  <div class="mx-auto flex h-16 w-full max-w-[1440px] items-center gap-4 px-5 sm:px-8 lg:h-[72px] lg:px-10">
    <a href={home} class="flex shrink-0 items-center" aria-label={`${site.name}, ${locale === "es" ? "inicio" : "home"}`}>
      <img src="/brand/equityfast-ink.webp" alt="EquityFast" width="1200" height="171" class="h-5 w-auto sm:h-[22px]" />
    </a>
    <div class="hidden shrink-0 items-center gap-2.5 border-l border-line pl-4 xl:flex">
      {/* Below 2xl the label would push the Spanish menu into the logo; the lender logo alone still reads. */}
      <span class="hidden text-xs leading-tight whitespace-nowrap text-graphite 2xl:inline">{t.poweredBy}</span>
      <img src="/brand/emc.webp" alt={site.business.legalName} width="640" height="145" loading="lazy" class="h-5 w-auto" />
    </div>
    <nav aria-label={t.mainNav} class="ml-auto hidden shrink-0 items-center gap-0.5 xl:flex">
      {
        items.map((item) => (
          <a
            href={item.url}
            aria-current={isActive(item.url) ? "page" : undefined}
            class="rounded-full px-3.5 py-2 text-[15px] font-medium whitespace-nowrap text-graphite hover:text-ink aria-[current=page]:bg-canvas aria-[current=page]:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-1.5 xl:ml-3">
      <a href={site.business.instagram} rel="noopener me" target="_blank" class="hidden size-10 items-center justify-center rounded-full text-graphite hover:bg-canvas hover:text-ink sm:flex" aria-label="Instagram @equityfast">
        <InstagramIcon class="size-[18px]" />
      </a>
      <a
        href={switchHref}
        hreflang={other}
        lang={other}
        class="flex h-9 items-center rounded-full border border-line px-3 text-xs font-medium text-ink uppercase hover:border-ink/40"
      >
        <span class="sr-only">{t.switchTo}</span>
        <span aria-hidden="true">{other}</span>
      </a>
      <ButtonLink href={APPLY_PATH[locale]} data-apply variant="accent" size="cta" class="ml-1.5 hidden sm:inline-flex">{t.startNow}</ButtonLink>
      <MobileMenu
        client:media="(max-width: 1279px)"
        items={items.map((item) => ({ href: item.url, label: item.label }))}
        currentPath={current}
        homes={["/", "/es"]}
        labels={{ close: t.close, nav: t.mainNav, open: t.menu }}
        classNames={{
          toggle: "ml-1 text-ink xl:hidden",
          overlay: "bg-white text-ink xl:hidden",
          nav: "container-page pt-8",
          link: "text-[2rem] font-medium tracking-[-0.03em] text-graphite aria-[current=page]:text-ink",
          footer: "container-page flex flex-col gap-4",
        }}
      >
        <ButtonLink href={APPLY_PATH[locale]} data-apply variant="accent" size="hero" class="w-full">{t.startNow}</ButtonLink>
        <a href={switchHref} hreflang={other} lang={other} class="text-center text-sm text-graphite hover:text-ink">{t.switchTo}</a>
      </MobileMenu>
    </div>
  </div>
</header>
