---
/**
 * Native `<details>`: opens without JavaScript, works with find-in-page and the
 * keyboard. Browsers with `::details-content` fade the answer in; those with
 * `interpolate-size` also grow it open. Others simply snap, as before.
 */
import ChevronDown from "@lucide/astro/icons/chevron-down";
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentFaqBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentFaqBlock>;

const { value } = Astro.props;
---

<section class="bg-sand py-20 sm:py-24">
  <div class="container-narrow">
    <h2 class="text-4xl sm:text-5xl">{value.headline}</h2>
    <div class="mt-10 divide-y divide-border border-y border-border">
      {value.items.map((item) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-medium text-navy [&::-webkit-details-marker]:hidden">
            {item.question}
            <ChevronDown class="size-5 shrink-0 text-muted-foreground transition-transform duration-250 ease-expo group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true" />
          </summary>
          <p class="max-w-[65ch] pb-6 leading-relaxed text-foreground/80">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details {
    interpolate-size: allow-keywords;
  }

  details::details-content {
    block-size: 0;
    opacity: 0;
    overflow-y: clip;
    transition:
      block-size 250ms var(--ease-out-expo),
      opacity 250ms var(--ease-out-expo),
      content-visibility 250ms allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  /* Reduced motion: the answer still fades, but doesn't slide the page. */
  @media (prefers-reduced-motion: reduce) {
    details::details-content {
      transition:
        opacity 250ms var(--ease-out-expo),
        content-visibility 250ms allow-discrete;
    }
  }
</style>
