---
/** Native `<details>`: opens without JavaScript, works with find-in-page and the keyboard. */
import ChevronDown from "@lucide/astro/icons/chevron-down";
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentFaqBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentFaqBlock>;

const { value } = Astro.props;
---

<section class="bg-sand py-20 sm:py-24">
  <div class="container-narrow">
    <h2 class="text-4xl sm:text-5xl">{value.headline}</h2>
    <div class="mt-10 divide-y divide-border border-y border-border">
      {value.items.map((item) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-medium text-navy [&::-webkit-details-marker]:hidden">
            {item.question}
            <ChevronDown class="size-5 shrink-0 text-muted-foreground transition-transform duration-300 ease-expo group-open:rotate-180" aria-hidden="true" />
          </summary>
          <p class="max-w-[65ch] pb-6 leading-relaxed text-foreground/80">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
