---
import type { BlockComponentProps } from "emdash/ui";

import type { PageContentHighlightsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentHighlightsBlock>;

const { value } = Astro.props;
---

<section class="border-t border-border py-20 sm:py-24">
  <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
    <div>
      <h2 class="text-4xl sm:text-5xl">{value.headline}</h2>
      {value.intro && <p class="mt-4 max-w-md text-lg leading-relaxed text-muted-foreground">{value.intro}</p>}
    </div>
    <dl class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
      {value.items.map((item) => (
        <div>
          <dt class="font-display text-2xl leading-snug text-navy">{item.title}</dt>
          <dd class="mt-2 leading-relaxed text-foreground/80">{item.body}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
