---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { sanitizeHref } from "emdash";
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import type { PageContentCtaBandBlock } from "../../../emdash-env";
import { site } from "../../../site.config";

type Props = BlockComponentProps<PageContentCtaBandBlock>;

const { value } = Astro.props;
const { address, directionsUrl } = site.business;
---

<section class="px-3 pb-3 sm:px-5 sm:pb-5">
  <div class="relative isolate overflow-hidden rounded-3xl bg-deep">
    {value.image && (
      <div class="absolute inset-0 -z-10">
        <Image image={value.image} alt="" sizes="100vw" class="size-full! object-cover" />
      </div>
    )}
    <div class="absolute inset-0 -z-10 bg-linear-to-r from-deep/90 via-deep/70 to-deep/30" aria-hidden="true"></div>
    <div class="container-page py-20 sm:py-28">
      <h2 class="max-w-2xl text-5xl text-white sm:text-6xl">{value.headline}</h2>
      {value.body && <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85">{value.body}</p>}
      <div class="mt-9 flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-8">
        {value.cta_label && value.cta_url && (
          <ButtonLink href={sanitizeHref(value.cta_url)} variant="inverse" size="hero" class="self-start">{value.cta_label}</ButtonLink>
        )}
        <a href={directionsUrl} target="_blank" rel="noopener" class="group inline-flex items-start gap-1.5 text-sm leading-snug text-white/80 hover:text-white">
          <span>{address.street}<br />{address.city}, {address.region}</span>
          <ArrowUpRight class="mt-0.5 size-3.5 shrink-0 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
          <span class="sr-only">(directions, opens in a new tab)</span>
        </a>
      </div>
    </div>
  </div>
</section>
