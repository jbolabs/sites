---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import type { BlockComponentProps } from "emdash/ui";

import NewsItem from "@/components/news-item.astro";
import { getCurrentNews } from "@/lib/content";
import type { PageContentAnnouncementsBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentAnnouncementsBlock>;

const { value } = Astro.props;
const news = await getCurrentNews();
if (Astro.cache?.enabled) {
  Astro.cache.set(news.cacheHint);
}
const [lead, ...rest] = news.entries.slice(0, value.count ?? 3);
---

{lead && (
  <section class="py-20 sm:py-28">
    <div class="container-page">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-4xl sm:text-5xl">{value.headline}</h2>
        <a href="/news" class="group inline-flex items-center gap-2 font-medium text-navy">All news<ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" /></a>
      </div>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-16">
        <NewsItem entry={lead} lead />
        {rest.length > 0 && (
          <div class="flex flex-col gap-6">
            {rest.map((entry) => <NewsItem entry={entry} />)}
          </div>
        )}
      </div>
    </div>
  </section>
)}
