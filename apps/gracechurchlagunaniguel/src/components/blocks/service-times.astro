---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import MapPin from "@lucide/astro/icons/map-pin";
import Phone from "@lucide/astro/icons/phone";
import type { BlockComponentProps } from "emdash/ui";

import { formatClock, formatTimes } from "@/lib/calendar";
import { getEvents, sundayServices } from "@/lib/content";
import type { PageContentServiceTimesBlock } from "../../../emdash-env";
import { site } from "../../../site.config";

type Props = BlockComponentProps<PageContentServiceTimesBlock>;

const { value } = Astro.props;
const events = await getEvents();
if (Astro.cache?.enabled) {
  Astro.cache.set(events.cacheHint);
}
const services = sundayServices(events.entries);
const { address, directionsUrl, telephone } = site.business;
---

<section class="py-20 sm:py-24">
  <div class="container-page">
    <div class="max-w-2xl">
      <h2 class="text-4xl sm:text-5xl">{value.headline}</h2>
      {value.intro && <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{value.intro}</p>}
    </div>
    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:gap-16">
      <ol class="divide-y divide-border border-y border-border">
        {services.map(({ item, schedule }) => (
          <li class="grid gap-x-8 gap-y-2 py-7 sm:grid-cols-[11rem_minmax(0,1fr)]">
            <p class="numerals font-display text-4xl leading-none whitespace-nowrap text-navy">{formatClock(schedule.start)}</p>
            <div>
              <h3 class="text-2xl leading-tight"><a href={`/events/${item.id}`} class="hover:underline hover:decoration-mist">{item.data.title}</a></h3>
              <p class="mt-1 text-sm text-muted-foreground">{formatTimes(schedule)}{item.data.location && ` · ${item.data.location}`}</p>
              <p class="mt-3 leading-relaxed text-foreground/80">{item.data.summary}</p>
            </div>
          </li>
        ))}
      </ol>
      <aside class="self-start rounded-2xl bg-sand p-7">
        <h3 class="text-2xl">Finding us</h3>
        <address class="mt-4 space-y-4 not-italic">
          <a href={directionsUrl} target="_blank" rel="noopener" class="group flex gap-3">
            <MapPin class="mt-1 size-4 shrink-0 text-navy" aria-hidden="true" />
            <span class="leading-relaxed">{address.street}<br />{address.city}, {address.region} {address.postalCode}<span class="mt-1 flex items-center gap-1 font-medium text-navy group-hover:underline">Get directions<ArrowUpRight class="size-3.5" aria-hidden="true" /></span></span>
          </a>
          <a href={`tel:${telephone}`} class="flex items-center gap-3 hover:underline">
            <Phone class="size-4 shrink-0 text-navy" aria-hidden="true" /><span class="numerals">{site.phone}</span>
          </a>
        </address>
      </aside>
    </div>
  </div>
</section>
