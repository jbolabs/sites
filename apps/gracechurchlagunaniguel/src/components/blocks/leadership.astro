---
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";
import type { BlockComponentProps } from "emdash/ui";

import { getPeople } from "@/lib/content";
import type { PageContentLeadershipBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentLeadershipBlock>;

const { value } = Astro.props;
const people = await getPeople();
if (Astro.cache?.enabled) {
  Astro.cache.set(people.cacheHint);
}
const ROLES = ["Pastor", "Elder", "Deacon", "Staff"] as const;
const PLURAL = { Deacon: "Deacons", Elder: "Elders", Pastor: "Pastors", Staff: "Staff" } as const;
const groups = ROLES.map((role) => ({
  people: people.entries.filter((person) => person.data.role === role),
  role,
})).filter((group) => group.people.length > 0);
---

{groups.length > 0 && (
  <section id="leadership" class="py-20 sm:py-28">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-4xl sm:text-5xl">{value.headline}</h2>
        {value.intro && <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{value.intro}</p>}
      </div>
      {groups.map((group) => (
        <div class="mt-12">
          <h3 class="font-sans text-sm font-semibold tracking-normal text-muted-foreground">{PLURAL[group.role]}</h3>
          <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
            {group.people.map((person) => (
              <li>
                <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-muted">
                  {person.data.photo && (
                    <Image image={person.data.photo} alt={person.data.photo.alt ?? person.data.title} sizes="(min-width: 1024px) 22vw, (min-width: 640px) 30vw, 46vw" class="size-full! object-cover object-top" />
                  )}
                </div>
                <p class="mt-3 font-display text-xl leading-tight text-navy">{person.data.title}</p>
                <p class="text-sm text-muted-foreground">{person.data.role}</p>
                {person.data.bio && <p class="mt-2 text-sm leading-relaxed text-foreground/80">{person.data.bio}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}
