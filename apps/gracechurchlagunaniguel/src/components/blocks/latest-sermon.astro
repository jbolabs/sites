---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import VideoPlayer from "@/components/video-player.astro";
import { formatEntryDate, getLatestSermon } from "@/lib/content";
import { youtubeId } from "@/lib/video";
import type { PageContentLatestSermonBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentLatestSermonBlock>;

const { value } = Astro.props;
const { cacheHint, entry } = await getLatestSermon();
if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
}
const sermon = entry?.data;
const video = youtubeId(sermon?.video_url);
const hasQuestions = (sermon?.study_questions?.length ?? 0) > 0;
---

{entry && sermon && (
  <section class="bg-deep py-20 text-paper sm:py-28">
    <div class="container-page grid items-center gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
      <div>
        <h2 class="text-4xl text-white sm:text-5xl">{value.headline}</h2>
        {value.intro && <p class="mt-4 max-w-md text-lg leading-relaxed text-paper/70">{value.intro}</p>}
        <div class="mt-10 border-t border-white/15 pt-8">
          <p class="text-sm text-mist">
            <time datetime={sermon.preached_on}>{formatEntryDate(sermon.preached_on)}</time>
            {sermon.series && <span> · {sermon.series}</span>}
          </p>
          <h3 class="mt-2 text-3xl leading-tight text-white sm:text-4xl">
            <a href={`/sermons/${entry.id}`} class="hover:underline hover:decoration-mist">{sermon.title}</a>
          </h3>
          <p class="mt-3 text-paper/75">
            {sermon.passage && sermon.passage !== sermon.title && <span>{sermon.passage} · </span>}{sermon.preacher}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <ButtonLink href={`/sermons/${entry.id}${hasQuestions ? "#study-questions" : ""}`} variant="inverse" size="cta">
              {hasQuestions ? "Study questions" : "Sermon details"}
            </ButtonLink>
            <ButtonLink href="/sermons" variant="outline-inverse" size="cta">All sermons<ArrowRight class="size-4" aria-hidden="true" /></ButtonLink>
          </div>
        </div>
      </div>
      {video && <VideoPlayer id={video} title={sermon.title} class="shadow-[0_30px_80px_-30px_rgb(0_0_0/0.6)]" />}
    </div>
  </section>
)}
