---
/** One announcement in a list: date, title, summary, and its photo when `lead`. */
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";

import { formatEntryDate } from "@/lib/content";
import type { Announcement, Entry } from "@/lib/content";

interface Props {
  entry: Entry<Announcement>;
  /** The first, larger item with a photo. */
  lead?: boolean;
  headingLevel?: "h2" | "h3";
}

const { entry, headingLevel: Heading = "h3", lead = false } = Astro.props;
const { data } = entry;
---

<article class:list={["group relative flex flex-col", lead ? "gap-5" : "gap-2 border-t border-border pt-6"]}>
  {lead && data.image && (
    <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-muted">
      <Image image={data.image} alt={data.image.alt ?? ""} sizes="(min-width: 1024px) 42vw, 100vw" class="size-full! object-cover transition-transform duration-700 ease-expo group-hover:scale-[1.03] motion-reduce:transition-none" />
    </div>
  )}
  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
    <time datetime={data.published_on}>{formatEntryDate(data.published_on)}</time>
    {data.pinned === true && <span class="rounded-full bg-accent px-2.5 py-0.5 text-xs font-medium text-navy">Pinned</span>}
  </p>
  <Heading class:list={["leading-tight", lead ? "text-3xl sm:text-4xl" : "text-2xl"]}>
    <a href={`/news/${entry.id}`} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-mist">{data.title}</a>
  </Heading>
  <p class:list={["leading-relaxed text-muted-foreground", { "text-lg": lead }]}>{data.summary}</p>
</article>
