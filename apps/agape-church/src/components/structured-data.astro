---
/**
 * Church JSON-LD on every page. EmDashHead adds the WebSite graph; this adds
 * the church itself, from site.config.ts so the footer and search engines
 * never disagree.
 */
import { site } from "../../site.config";

interface Props {
  origin: string;
}

const { origin } = Astro.props;
const { address, email, social, telephone } = site.business;

const data = {
  "@context": "https://schema.org",
  "@type": "Church",
  address: {
    "@type": "PostalAddress",
    addressCountry: "US",
    addressLocality: address.city,
    addressRegion: address.region,
    postalCode: address.postalCode,
    streetAddress: address.street,
  },
  description: site.description,
  email,
  image: `${origin}/og-default.png`,
  logo: `${origin}/brand/logo.png`,
  name: site.name,
  sameAs: [social.facebook, social.youtube, social.x],
  telephone,
  url: origin,
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
