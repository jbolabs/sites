---
/**
 * The church's address, phone, and weekly schedule on every page (the old
 * site's "Agape Church Program" box), the locale's footer and resources menus,
 * and the social accounts. Contact facts come from site.config.ts so the
 * footer and structured data never disagree; the schedule is CMS site text.
 */
import type { Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import type { SiteChrome } from "@/lib/content";
import { mapsUrl, phoneHref, phoneLabel } from "@/lib/church";
import { site } from "../../site.config";
import SocialIcon from "./social-icon.astro";
import Wordmark from "./wordmark.astro";

interface Props {
  locale: Locale;
  chrome: SiteChrome;
}

const { chrome, locale } = Astro.props;
const t = ui(locale);
const { address, email, social } = site.business;
const year = new Date().getFullYear();
const socials = [
  { href: social.facebook, label: t.social.facebook, name: "facebook" },
  { href: social.youtube, label: t.social.youtube, name: "youtube" },
  { href: social.x, label: t.social.x, name: "x" },
] as const;
---

<footer class="bg-ink-deep text-white/75">
  <div class="container-page grid gap-12 pt-16 pb-12 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_0.8fr_0.9fr]">
    <div class="space-y-5">
      <Wordmark tone="light" />
      {chrome.motto && <p class="max-w-sm text-sm leading-relaxed">{chrome.motto}</p>}
      <address class="space-y-1.5 text-sm not-italic">
        <a href={mapsUrl} rel="noopener" target="_blank" class="block hover:text-white">{address.street}<br />{address.city}, {address.region} {address.postalCode}</a>
        <a href={phoneHref} class="block hover:text-white">{phoneLabel}</a>
        <a href={`mailto:${email}`} class="block hover:text-white">{email}</a>
      </address>
      <ul class="flex gap-2">
        {socials.map((item) => (
          <li>
            <a href={item.href} rel="noopener me" target="_blank" aria-label={item.label} class="flex size-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20">
              <SocialIcon name={item.name} class="size-[1.1rem]" />
            </a>
          </li>
        ))}
      </ul>
    </div>
    {chrome.schedule.length > 0 && (
      <div>
        <h2 class="mb-4 font-sans text-sm font-semibold text-white">{t.serviceTimes}</h2>
        <dl class="space-y-3 text-sm">
          {chrome.schedule.map((item) => (
            <div>
              <dt class="text-white/55">{item.day}</dt>
              <dd class="flex justify-between gap-4 text-white/85"><span>{item.name}</span><span class="tabular-nums">{item.time}</span></dd>
            </div>
          ))}
        </dl>
      </div>
    )}
    <nav aria-label={t.footerNav}>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5 text-sm lg:grid-cols-1">
        {chrome.footer.map((item) => (
          <li><a href={item.url} class="inline-flex min-h-6 items-center hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label={t.resourcesNav}>
      <ul class="space-y-2.5 text-sm">
        {chrome.resources.map((item) => (
          <li><a href={item.url} class="inline-flex min-h-6 items-center hover:text-white">{item.label}</a></li>
        ))}
        <li><a href="https://agapecca.org/" rel="noopener" target="_blank" class="inline-flex min-h-6 items-center hover:text-white">Agape Classical Christian Academy</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/10">
    <p class="container-page pt-6 pb-safe text-xs text-white/55">&copy; {year} Agape Christian Church of Orange County. {t.rights}</p>
  </div>
</footer>
