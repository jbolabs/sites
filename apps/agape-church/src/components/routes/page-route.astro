---
/** A CMS page view, shared by `/<slug>` and `/ro/<slug>`: the page header, then its sections. */
import PageBlocks from "@/components/blocks/page-blocks.astro";
import PageHeader from "@/components/page-header.astro";
import Base from "@/layouts/base.astro";
import type { PageData } from "@/lib/routes";

type Props = PageData;

const { alternates, crumbs, page, seo } = Astro.props;
---

<Base
  title={seo.title}
  description={seo.description}
  image={seo.ogImage}
  canonical={seo.canonical}
  robots={seo.robots}
  alternates={alternates}
  crumbs={crumbs}
  content={{ collection: "pages", id: page.data.id, slug: page.id }}
>
  <PageHeader title={page.data.title} intro={page.data.intro} image={page.data.image} crumbs={crumbs} />
  <div {...page.edit.content}><PageBlocks value={page.data.content} /></div>
</Base>
