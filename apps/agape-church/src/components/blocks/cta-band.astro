---
/** A closing band with a headline, text, and up to two buttons, over an optional photo. */
import { sanitizeHref } from "emdash";
import { Image } from "emdash/ui";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import type { PageContentCtaBandBlock } from "../../../emdash-env";

type Props = BlockComponentProps<PageContentCtaBandBlock>;

const { value } = Astro.props;
const link = (label: string | null | undefined, url: string | null | undefined) =>
  label && url ? { href: sanitizeHref(url), label } : undefined;
const primary = link(value.primary_label, value.primary_url);
const secondary = link(value.secondary_label, value.secondary_url);
---

<section class="container-page py-10 sm:py-14">
  <div class="relative isolate overflow-hidden rounded-[1.75rem] bg-ink-deep">
    {value.image && <Image image={value.image} alt="" sizes="(min-width: 1280px) 1216px, 100vw" class="absolute inset-0 -z-10 size-full! object-cover" />}
    <div class="absolute inset-0 -z-10 bg-linear-to-r from-ink-deep/95 via-ink-deep/80 to-ink-deep/40" aria-hidden="true"></div>
    <div class="flex flex-col items-start gap-8 px-7 py-14 sm:px-12 sm:py-20 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-4xl text-white sm:text-5xl">{value.headline}</h2>
        {value.body && <p class="mt-4 text-lg leading-relaxed text-white/80">{value.body}</p>}
      </div>
      {(primary || secondary) && (
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row md:flex-col lg:flex-row">
          {primary && <ButtonLink href={primary.href} variant="accent" size="hero">{primary.label}</ButtonLink>}
          {secondary && <ButtonLink href={secondary.href} variant="outline-inverse" size="hero">{secondary.label}</ButtonLink>}
        </div>
      )}
    </div>
  </div>
</section>
