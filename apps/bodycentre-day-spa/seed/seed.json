          "content": [
            {
              "_type": "hero",
              "_version": 1,
              "_key": "hero",
              "headline": "Leave lighter than you arrived.",
              "subheadline": "Massage, facials, and recovery therapies under one roof in Costa Mesa, since 1994.",
              "image": {
                "$media": {
                  "url": "/_seed/media/spa-lobby-hero.jpg",
                  "alt": "BodyCentre Day Spa's lobby with lounge chairs, shelves of skin care, and a bar counter",
                  "filename": "spa-lobby-hero.jpg"
                }
              },
              "book_label": "Book now"
            },
            {
              "_type": "services",
              "_version": 1,
              "_key": "treatments",
              "headline": "Treatments",
              "intro": "A full day spa menu next to a recovery studio and a private training gym. Prices are starting rates from the current online menu.",
              "items": [
                {
                  "title": "Massage",
                  "body": "Swedish relaxation, deep tissue, hot stone, prenatal, sports, lymphatic, reflexology, cupping, and more, in 55, 70, 85, or 115 minute sessions.",
                  "price": "From $99",
                  "image": {
                    "$media": {
                      "url": "/_seed/media/back-massage.jpg",
                      "alt": "Therapist working on a guest's shoulders",
                      "filename": "back-massage.jpg"
                    }
                  }
                },
                {
                  "title": "Facials and skin care",
                  "body": "European, HydraFacial, microdermabrasion, dermaplaning, anti-aging, acne, and rosacea facials, each starting with a skin analysis by a licensed esthetician.",
                  "price": "European Facial $125",
                  "image": {
                    "$media": {
                      "url": "/_seed/media/hydrafacial.jpg",
                      "alt": "Esthetician giving a hydrating facial treatment",
                      "filename": "hydrafacial.jpg"
                    }
                  }
                },
                {
                  "title": "Recovery and biohacking",
                  "body": "Hyperbaric oxygen at 1.6 and 2.0 ATA, whole-body red light, PEMF, compression, exercise with oxygen, and molecular hydrogen.",
                  "price": "Hyperbaric oxygen from $150",
                  "image": {
                    "$media": {
                      "url": "/_seed/media/hyperbaric-chamber.jpg",
                      "alt": "BodyCentre's hyperbaric oxygen chamber in the recovery studio",
                      "filename": "hyperbaric-chamber.jpg"
                    }
                  }
                },
                {
                  "title": "Spa packages",
                  "body": "Massage and facial pairings, from the mid-week massage special to the Platinum Spa Package.",
                  "price": "From $89",
                  "link_label": "See packages",
                  "link_url": "https://www.bodycentredayspa.com/massage-facial-packages"
                },
                {
                  "title": "Massage memberships",
                  "body": "One massage a month and 10% off every other service and lobby product, on a three month term.",
                  "price": "55 minutes, $89 a month",
                  "link_label": "Join",
                  "link_url": "https://www.bodycentredayspa.com/55minute-massage-membership"
                },
                {
                  "title": "Body treatments",
                  "body": "Glacial salt body polish, herbal wrap, custom spray tan, cavitation, Emerald laser, and colon hydrotherapy."
                },
                {
                  "title": "Waxing",
                  "body": "Waxing for men and women by a dedicated waxologist."
                },
                {
                  "title": "Personal training",
                  "body": "A private training gym. Plans start with a fitness assessment and an InBody composition analysis."
                }
              ],
              "note": "FSA and HSA cards are accepted for eligible services, with detailed receipts for your claim."
            },
            {
              "_type": "reviews",
              "_version": 1,
              "_key": "reviews",
              "headline": "Why guests keep coming back",
              "intro": "In Costa Mesa since 1994, with a menu that runs from a quiet facial to a hyperbaric session.",
              "highlights": [
                {
                  "text": "Voted Best Day Spa in Orange County"
                },
                {
                  "text": "OC Weekly Best of 2019"
                },
                {
                  "text": "Woman, veteran, and family owned since 1994"
                },
                {
                  "text": "A homemade baked treat after every service"
                }
              ],
              "ratings": [
                {
                  "source": "Yelp",
                  "score": "4.6",
                  "count": "843 reviews",
