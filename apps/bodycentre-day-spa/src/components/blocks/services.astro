---
import Image from "@jakebodea/cloudflare-kit/astro/image.astro";
import type { BlockComponentProps } from "emdash/ui";

import ButtonLink from "@/components/button-link.astro";
import Fill from "@/components/fill.astro";
import type { HomeContentServicesBlock } from "../../../emdash-env";
import { site } from "../../../site.config";

type Props = BlockComponentProps<HomeContentServicesBlock>;

const { value } = Astro.props;
// Treatments with a photo lead as large cards; the rest follow as a compact menu.
const featured = value.items.filter((item) => item.image);
const more = value.items.filter((item) => !item.image);
---

<section id="treatments" class="bg-stone py-20 sm:py-28">
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-4xl sm:text-5xl"><Fill text={value.headline} /></h2>
      {value.intro && <p class="mt-4 text-lg leading-relaxed text-muted-foreground"><Fill text={value.intro} /></p>}
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {featured.map((item, index) => (
        <li class="group flex flex-col overflow-hidden rounded-xl bg-card" data-reveal style={`--i: ${index}`}>
          {item.image && (
            <div class="zoom-photo aspect-[3/2] overflow-hidden bg-muted">
              <Image image={item.image} alt={item.image.alt ?? ""} sizes="(min-width: 768px) 30vw, 100vw" class="size-full! object-cover" />
            </div>
          )}
          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <h3 class="text-[1.75rem] leading-tight"><Fill text={item.title} /></h3>
            <p class="mt-3 flex-1 leading-relaxed text-muted-foreground"><Fill text={item.body} /></p>
            {item.price && <p class="mt-5 font-medium text-slate lining-nums"><Fill text={item.price} /></p>}
          </div>
        </li>
      ))}
    </ul>
    {more.length > 0 && (
      <ul class="mt-6 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-5" data-reveal>
        {more.map((item) => (
          <li class="flex flex-col bg-card p-6">
            <h3 class="text-2xl leading-tight"><Fill text={item.title} /></h3>
            <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-muted-foreground"><Fill text={item.body} /></p>
            {item.price && <p class="mt-4 font-medium text-slate lining-nums"><Fill text={item.price} /></p>}
          </li>
        ))}
      </ul>
    )}
    <div class="mt-10 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      {value.note && <p class="max-w-2xl text-muted-foreground"><Fill text={value.note} /></p>}
      <ButtonLink href={site.business.bookingUrl} size="cta" class="self-start sm:self-auto">See times and book</ButtonLink>
    </div>
  </div>
</section>
