---
/**
 * The BodyCentre monogram (their own artwork, which has a white ground) with
 * the name set beside it. `mix-blend-multiply` drops the white into the warm
 * page color, so the mark needs no traced transparent version for the mock-up.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["flex items-center gap-3", className]}>
  <img src="/brand/mark.webp" alt="" width="128" height="130" class="size-11 mix-blend-multiply sm:size-12" />
  <span class="flex flex-col leading-none">
    <span class="font-display text-[1.6rem] font-medium tracking-[0.04em] text-slate sm:text-[1.75rem]">BodyCentre</span>
    <span class="mt-1 text-[0.8rem] text-muted-foreground">Day Spa · Costa Mesa</span>
  </span>
</span>
