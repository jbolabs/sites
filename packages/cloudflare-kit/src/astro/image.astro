---
/**
 * EmDash's `<Image>` with two fixes; use it wherever a site would use EmDash's.
 * A seeded photo gets its blurred placeholder (`emdash/seed-placeholders`), so
 * its box shows the photo's colors, not an empty background, until it loads;
 * and the srcset stops at the original's width (`emdash/image-widths`).
 */
import type { ComponentProps } from "astro/types";
import { Image as EmDashImage } from "emdash/ui";
import placeholders from "virtual:seed-placeholders";

import { photoProps } from "../emdash/photo.ts";

type Props = ComponentProps<typeof EmDashImage>;

const { image, ...props } = Astro.props;
const photo = photoProps(image, placeholders);
---

<EmDashImage image={photo.image} {...(photo.widths && { widths: photo.widths })} {...props} />
